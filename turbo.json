{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "FOUNDRY_TEST_DATABASE_URL",
    "FOUNDRY_E2E_BASE_URL",
    "FOUNDRY_GIT_BASE",
    "AUTH_SECRET",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
