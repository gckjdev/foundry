# Control plane
# Postgres (default, production). For a zero-Postgres local run use SQLite instead:
#   DATABASE_URL=file:./data/foundry.sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foundry
FOUNDRY_PUBLIC_URL=http://localhost:3000
FOUNDRY_REALTIME_URL=ws://localhost:3001
# Shared secret for signing realtime tokens and artifact URLs (32+ random bytes)
FOUNDRY_SECRET=change-me-to-a-long-random-string

# GitHub App (https://github.com/settings/apps/new)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

# GitHub OAuth (the GitHub App's client ID/secret work here)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=change-me

# Outbound HTTP proxy for GitHub, coding-agent APIs, git, and webhooks (not localhost).
# Node/Bun/git do not use the macOS system proxy; Foundry does if this is unset.
# FOUNDRY_HTTP_PROXY=http://127.0.0.1:8118
# FOUNDRY_NO_PROXY=localhost,127.0.0.1,::1

# Artifacts: local directory by default; set S3_* to use S3-compatible storage
ARTIFACTS_DIR=./data/artifacts
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=

# Notifications (all optional)
SMTP_URL=
EMAIL_FROM=Foundry <foundry@example.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Local development: forward GitHub webhooks with `pnpm dev:webhooks`
SMEE_URL=
